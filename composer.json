{
  "name": "leadinfo-extension/leadinfo",
  "keywords": [
    "TYPO3",
    "extension",
    "lead",
    "leadinfo",
    "tracking-code",
    "analytics",
    "site-analytics"
  ],

  "type": "typo3-cms-extension",
  "description": "Leadinfo enables you to see real-time which companies are visiting your website and what pages they’re viewing to increase your sales.",
  "authors": [
    {
      "name": "Leadinfo",
      "role": "Developer"
    }
  ],
  "license": "GPL-2.0-or-later",
  "require": {
    "php": "^8.2",
    "typo3/cms-core": "^13.4"
  },
  "autoload": {
    "psr-4": {
      "LeadinfoExtension\\Leadinfo\\": "Classes"
    }
  },
  "replace": {
    "typo3-ter/leadinfo": "self.version"
  },
  "config": {
    "vendor-dir": ".Build/vendor",
    "bin-dir": ".Build/bin"
  },
  "extra": {
    "typo3/cms": {
      "cms-package-dir": "{$vendor-dir}/typo3/cms",
      "web-dir": ".Build/public",
      "extension-key": "leadinfo"
    }
  }
}
